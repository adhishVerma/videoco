PORT=5000

# Comma-separated list of client origins allowed to call this server
CLIENT_URL=http://localhost:3000

# Self-hosted TURN (coturn) - see coturn/README.md. Takes priority over
# Twilio below when both are set. TURN_SECRET must match turnserver.conf's
# static-auth-secret.
TURN_SERVER_URL=
TURN_SECRET=

# Twilio Network Traversal Service credentials, used as a fallback TURN
# provider when TURN_SERVER_URL/TURN_SECRET aren't set
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Cloudflare R2 (S3-compatible object storage) for chat attachments.
# Dashboard -> R2 -> create a bucket -> Manage API tokens -> create an S3
# API token for R2_ACCESS_KEY_ID/R2_SECRET_ACCESS_KEY. R2_ACCOUNT_ID is in
# the dashboard URL / account overview. Leave any of these blank and
# attachments stay disabled (the client hides the upload button).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public base URL for the bucket - either its r2.dev URL (bucket Settings ->
# Public access -> Allow Access) or a custom domain attached to it.
R2_PUBLIC_URL=

# LiveKit (SFU media server) for group calls - replaces the peer-to-peer
# mesh once set. cloud.livekit.io -> your project -> Settings -> API Keys
# for LIVEKIT_API_KEY/LIVEKIT_API_SECRET, and the project overview page for
# LIVEKIT_URL (wss://<project>.livekit.cloud). Leave any blank and the app
# falls back to the original mesh (simple-peer) path.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=
