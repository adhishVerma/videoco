PORT=5000

# Comma-separated list of client origins allowed to call this server.
# In production this is your Vercel deployment(s), e.g.:
# CLIENT_URL=https://videoco.vercel.app,https://ballasgang.shop
CLIENT_URL=http://localhost:3000

# Self-hosted TURN (coturn) - see coturn/README.md. Takes priority over
# Twilio below when both are set. TURN_SECRET must match turnserver.conf's
# static-auth-secret.
TURN_SERVER_URL=
TURN_SECRET=

# Twilio Network Traversal Service credentials, used as a fallback TURN
# provider when TURN_SERVER_URL/TURN_SECRET aren't set
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Cloudflare R2 (S3-compatible object storage) for chat attachments.
# Dashboard -> R2 -> create a bucket -> Manage API tokens -> create an S3
# API token for R2_ACCESS_KEY_ID/R2_SECRET_ACCESS_KEY. R2_ACCOUNT_ID is in
# the dashboard URL / account overview. Leave any of these blank and
# attachments stay disabled (the client hides the upload button).
#
# IMPORTANT - the browser uploads straight to R2 using a pre-signed URL
# (never through this server), so R2's OWN CORS policy has to allow it -
# our CLIENT_URL allowlist above has no effect here, this is a completely
# separate setting. Without it, uploads fail with a network/CORS error in
# the browser console that never reaches this server's logs at all.
# Bucket -> Settings -> CORS Policy -> add:
#   [
#     {
#       "AllowedOrigins": ["https://videoco.vercel.app", "https://ballasgang.shop", "http://localhost:3000"],
#       "AllowedMethods": ["PUT", "GET"],
#       "AllowedHeaders": ["Content-Type"],
#       "MaxAgeSeconds": 3000
#     }
#   ]
# (swap in your actual Vercel/production origins)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public base URL for the bucket - either its r2.dev URL (bucket Settings ->
# Public access -> Allow Access) or a custom domain attached to it.
R2_PUBLIC_URL=

# LiveKit (SFU media server) for group calls - replaces the peer-to-peer
# mesh once set. cloud.livekit.io -> your project -> Settings -> API Keys
# for LIVEKIT_API_KEY/LIVEKIT_API_SECRET, and the project overview page for
# LIVEKIT_URL (wss://<project>.livekit.cloud). Leave any blank and the app
# falls back to the original mesh (simple-peer) path.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=

# Idle room timeout. A room with exactly ONE person left in it is ended after
# this many milliseconds, so an abandoned call (a forgotten tab, guests who all
# dropped) stops using - and being billed for - the media server. The lone
# participant gets a warning ROOM_ALONE_WARNING_MS before, with a "Keep room
# open" button. A second person arriving cancels the countdown. Set
# ROOM_ALONE_TIMEOUT_MS=0 to disable. Defaults: 10 minutes / 1 minute.
ROOM_ALONE_TIMEOUT_MS=600000
ROOM_ALONE_WARNING_MS=60000
