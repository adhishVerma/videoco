# coturn config for videoco. Copy to turnserver.conf, fill in the values
# below, and put a TLS cert/key in ./certs before starting the container.

listening-port=3478
tls-listening-port=5349

listening-ip=0.0.0.0
relay-ip=0.0.0.0

# the VM's public IP (or the DNS name below resolved once at boot)
external-ip=YOUR_SERVER_PUBLIC_IP

# relayed media uses one port per active connection out of this range -
# your cloud firewall/security group must allow inbound UDP across it
min-port=49152
max-port=65535

# time-limited credentials: same secret as the server's TURN_SECRET env var.
# generate one with: openssl rand -hex 32
use-auth-secret
static-auth-secret=CHANGE_ME

realm=turn.yourdomain.com

# TLS cert for turns:// (recommended - some networks only allow TURN over
# a port that looks like standard HTTPS). Get one with certbot/Let's Encrypt.
cert=/etc/coturn/certs/fullchain.pem
pkey=/etc/coturn/certs/privkey.pem

no-tlsv1
no-tlsv1_1
no-multicast-peers
no-cli
fingerprint
log-file=stdout
